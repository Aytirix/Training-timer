# SDK paths used by the Makefile
FLUTTER_SDK=/absolute/path/to/flutter
ANDROID_SDK_ROOT=/absolute/path/to/android/sdk

# Android release signing
# Leave these empty to let `make app-generate-keystore` generate them automatically
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
# Optional: validity in days, default 10000
# ANDROID_KEYSTORE_VALIDITY_DAYS=10000
# Optional: avoid interactive prompts from keytool
# ANDROID_KEYSTORE_DNAME=CN=Training Timer, OU=Mobile, O=Your Org, L=Paris, ST=Ile-de-France, C=FR

# GitHub release publication
# Optional: inferred automatically from `git remote get-url origin`
# GITHUB_REPOSITORY=owner/repo

# Required for `scripts/release-github.sh`
# Token must have repository Contents: write
GITHUB_TOKEN=
